# Netlify ve Cloudflare Pages tarafından okunur. Güncellemelerin telefonlara hemen ulaşması için.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
